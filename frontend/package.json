{
  "name": "cedar-table-queue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "build": "bun run typecheck && bun --bun vite build",
    "preview": "bun --bun vite preview --host 0.0.0.0",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test tests/unit",
    "test:e2e": "bun --bun playwright test"
  },
  "dependencies": {
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
