# Local development only. setup-dev.ps1 creates .env and replaces change-me.
SPRING_PROFILES_ACTIVE=demo
DATABASE_URL=jdbc:postgresql://localhost:5433/cedar
DATABASE_USERNAME=cedar
DATABASE_PASSWORD=change-me
TEST_DATABASE_URL=jdbc:postgresql://localhost:5433/cedar_test
TEST_DATABASE_USERNAME=cedar
TEST_DATABASE_PASSWORD=change-me
PGHOST=localhost
PGPORT=5433
PGDATABASE=cedar
PGUSER=cedar
# Optional PostgreSQL bin directory. Blank discovers the workspace installation / PATH.
PG_BIN=
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
# HTTPS deployments must use true and must not enable the demo/dev profiles.
SESSION_COOKIE_SECURE=false
# Production first-manager credentials are supplied only for initial provisioning.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Operational record retention; active account credentials are retained.
APP_RETENTION_DAYS=90
APP_RETENTION_CRON=0 17 3 * * *
